"""
Calendar window for the Launchpad calendar chord.

The board's month is eight columns of coloured pads and can only ever show one
mode at a time. This shows the same month with both of them at once -- the
pomodoros claimed on a day and how the day's fast went -- plus the arithmetic
the pads cannot do: an average, and how the diet days divide up.

It follows the board: change the month there and it changes here, because the
board sends the month it is drawing rather than the window deciding for itself.

stdin:   data <json>   {title, weeks, month, week, mode}
         show          display
         hide          withdraw
stdout:  nothing. It is a readout, not a control -- the pads are where you
         press, and a second set of handlers for the same days is a second set
         to keep right.
"""
import sys, json, re, subprocess, threading, queue
import tkinter as tk

COLS, ROWS = 7, 6
BG, CELL_BG, MUTED = '#0d0d11', '#191920', '#5a5a66'
WHITE, DIM = '#e8e8e8', '#8a8a96'
TODAY_EDGE = '#3aa0ff'                     # the same sky the pad flashes
# the fasting states, as a background the day number stays readable on
FAST_BG = {0: CELL_BG, 1: '#123021', 2: '#3a1618'}
FAST_INK = {0: MUTED, 1: '#33d17a', 2: '#ff4444'}
FAST_NAME = {0: 'nothing said', 1: 'went well', 2: 'did not'}
DAYS = ('Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat')
CELL_H = 150


def g9_centre_box():
    """The widest monitor's work area. Same as the other windows, so every one
    of them lands where the last one did."""
    try:
        mons = subprocess.run(['xrandr', '--listmonitors'],
                              capture_output=True, text=True).stdout
        best = None
        for line in mons.splitlines():
            m = re.search(r'(\d+)/\d+x(\d+)/\d+\+(\d+)\+(\d+)', line)
            if m:
                w, h, x, y = map(int, m.groups())
                if not best or w > best[0]:
                    best = (w, h, x, y)
        gw, gh, gx, gy = best
        wa = subprocess.run(['xprop', '-root', '_NET_WORKAREA'],
                            capture_output=True, text=True).stdout
        n = [int(v) for v in re.findall(r'\d+', wa.split('=')[1])]
        top, bot = max(gy, n[1]), min(gy + gh, n[1] + n[3])
        w = min(3840, gw)
        return w, bot - top, gx + (gw - w) // 2, top
    except Exception:
        return 1600, 900, 100, 100


def ramp(n):
    """The pomodoro count as a colour, the same ramp the pads use: white for
    none, green at eight, magenta at sixteen."""
    if n <= 0:
        return DIM
    f = min(n, 8) / 8
    if n <= 8:
        f = f ** 0.5
        r, g, b = round(255 * (1 - f)), 255, round(255 * (1 - f))
    else:
        f = (min(n, 16) - 8) / 8
        r, g, b = round(255 * f), round(255 * (1 - f)), round(255 * f)
    return f'#{r:02x}{g:02x}{b:02x}'


class Window:
    def __init__(self):
        self.data = {}
        self._fits = []
        self.root = tk.Tk()
        self.root.title('calendar')
        self.root.configure(bg=BG)
        self.root.attributes('-topmost', True)
        w, h, x, y = g9_centre_box()
        self.root.geometry(f'{w}x{h}+{x}+{y}')
        self.root.protocol('WM_DELETE_WINDOW', self.hide)

        outer = tk.Frame(self.root, bg=BG)
        outer.pack(fill='x', expand=True, padx=22)
        self.title = tk.Label(outer, text='', font=('DejaVu Sans', 30, 'bold'),
                              fg=WHITE, bg=BG, anchor='w')
        self.title.grid(row=0, column=0, columnspan=COLS, sticky='w', pady=(0, 10))
        for c, name in enumerate(DAYS):
            outer.grid_columnconfigure(c, weight=1, uniform='day')
            tk.Label(outer, text=name, font=('DejaVu Sans', 15), fg=MUTED,
                     bg=BG).grid(row=1, column=c, sticky='ew')

        self.cells, self.nums, self.pomos, self.fasts = {}, {}, {}, {}
        for r in range(ROWS):
            outer.grid_rowconfigure(r + 2, minsize=CELL_H)
            for c in range(COLS):
                f = tk.Frame(outer, bg=CELL_BG, highlightthickness=4,
                             highlightbackground=BG, width=120, height=CELL_H)
                f.grid(row=r + 2, column=c, sticky='nsew', padx=4, pady=4)
                f.grid_propagate(False)
                f.pack_propagate(False)          # a long line must not widen a column
                self.cells[(r, c)] = f
                n = tk.Label(f, text='', font=('DejaVu Sans', 17), fg=MUTED,
                             bg=CELL_BG, anchor='w')
                n.pack(anchor='nw', padx=10, pady=(6, 0))
                self.nums[(r, c)] = n
                mid = tk.Frame(f, bg=CELL_BG)
                mid.pack(expand=True)
                p = tk.Label(mid, text='', font=('DejaVu Sans', 30, 'bold'),
                             fg=DIM, bg=CELL_BG)
                p.pack()
                self.pomos[(r, c)] = p
                d = tk.Label(f, text='', font=('DejaVu Sans', 14), fg=MUTED,
                             bg=CELL_BG, anchor='w')
                d.pack(anchor='sw', padx=10, pady=(0, 6))
                self.fasts[(r, c)] = d

        # the arithmetic the pads cannot do
        stats = tk.Frame(outer, bg=BG)
        stats.grid(row=ROWS + 2, column=0, columnspan=COLS, sticky='ew', pady=(14, 0))
        self.panels = {}
        for i, key in enumerate(('month', 'week')):
            stats.grid_columnconfigure(i, weight=1, uniform='stat')
            box = tk.Frame(stats, bg=CELL_BG)
            box.grid(row=0, column=i, sticky='ew', padx=(0, 12) if i == 0 else (12, 0))
            head = tk.Label(box, text='', font=('DejaVu Sans', 16), fg=MUTED,
                            bg=CELL_BG, anchor='w')
            head.pack(anchor='w', padx=14, pady=(10, 0))
            body = tk.Label(box, text='', font=('DejaVu Sans', 22), fg=WHITE,
                            bg=CELL_BG, anchor='w', justify='left')
            body.pack(anchor='w', padx=14, pady=(2, 12))
            self.panels[key] = (head, body)

        self.root.bind_all('<Escape>', lambda ev: (self.hide(), 'break')[1])
        self.root.withdraw()

    # ---- geometry --------------------------------------------------------
    def place(self):
        w, h, x, y = g9_centre_box()
        self.root.geometry(f'{w}x{h}+{x}+{y}')

    def fit(self):
        """Keep the frame inside the work area; measured rather than predicted,
        for the reason habit-popup gives."""
        try:
            self.root.update_idletasks()
            wa = subprocess.run(['xprop', '-root', '_NET_WORKAREA'],
                                capture_output=True, text=True).stdout
            n = [int(v) for v in re.findall(r'\d+', wa.split('=')[1])]
            ex = subprocess.run(['xprop', '-id', str(self.root.winfo_id()),
                                 '_NET_FRAME_EXTENTS'],
                                capture_output=True, text=True).stdout
            border = int(re.findall(r'\d+', ex.split('=')[1])[3]) if '=' in ex else 8
            h = n[1] + n[3] - self.root.winfo_rooty() - border
            if 240 <= h < self.root.winfo_height():
                self.root.geometry(f'{self.root.winfo_width()}x{h}')
        except Exception:
            pass

    # ---- painting --------------------------------------------------------
    def paint(self):
        self.title.configure(text=self.data.get('title', ''))
        weeks = self.data.get('weeks', [])
        for r in range(ROWS):
            week = weeks[r] if r < len(weeks) else []
            for c in range(COLS):
                day = week[c] if c < len(week) else None
                frame = self.cells[(r, c)]
                if not day:
                    frame.configure(bg=BG, highlightbackground=BG)
                    for w in (self.nums, self.pomos, self.fasts):
                        w[(r, c)].configure(text='', bg=BG)
                    continue
                bg = FAST_BG.get(day.get('fast', 0), CELL_BG)
                edge = TODAY_EDGE if day.get('today') else BG
                frame.configure(bg=bg, highlightbackground=edge, highlightcolor=edge)
                n = day.get('pomos', 0)
                self.nums[(r, c)].configure(
                    text=str(day['day']) + ('  ●' if day.get('mark') else ''),
                    bg=bg, fg=WHITE if day.get('today') else MUTED)
                self.pomos[(r, c)].configure(text=str(n) if n else '·',
                                             fg=ramp(n), bg=bg)
                self.pomos[(r, c)].master.configure(bg=bg)
                self.fasts[(r, c)].configure(
                    text=FAST_NAME.get(day.get('fast', 0), ''),
                    fg=FAST_INK.get(day.get('fast', 0), MUTED), bg=bg)
        for key, (head, body) in self.panels.items():
            s = self.data.get(key) or {}
            head.configure(text=s.get('label', ''))
            if not s.get('days'):
                body.configure(text='nothing yet')
                continue
            body.configure(text=(
                f"{s['avg']:.1f} pomodoros a day   ({s['pomos']} over {s['days']})\n"
                f"fasting   {s['green']} well · {s['yellow']} unsaid · {s['red']} not"))

    # ---- protocol --------------------------------------------------------
    def handle(self, line):
        p = line.split('\t')
        if p[0] == 'data' and len(p) > 1:
            self.data = json.loads(p[1])
            if self.root.state() != 'withdrawn':
                self.paint()
        elif p[0] == 'show':
            self.paint()
            self.place()
            self.root.deiconify()
            self.root.lift()
            self.root.attributes('-topmost', True)
            self.root.update_idletasks()
            self.fit()
            for ms in (120, 600):
                self._fits.append(self.root.after(ms, self.fit))
        elif p[0] == 'hide':
            self.hide()

    def hide(self):
        while self._fits:
            try:
                self.root.after_cancel(self._fits.pop())
            except Exception:
                pass
        self.root.withdraw()

    def run(self):
        q = queue.Queue()

        def rd():
            for l in sys.stdin:
                q.put(l.rstrip('\n'))
            q.put(None)
        threading.Thread(target=rd, daemon=True).start()

        def pump():
            # one bad line must never stop the pump, or the window goes deaf
            try:
                while True:
                    l = q.get_nowait()
                    if l is None:
                        self.root.destroy()
                        return
                    try:
                        self.handle(l)
                    except Exception as e:
                        print(f'bad command {l[:60]!r}: {e!r}', file=sys.stderr, flush=True)
            except queue.Empty:
                pass
            self.root.after(16, pump)
        self.root.after(16, pump)
        self.root.mainloop()


if __name__ == '__main__':
    Window().run()
