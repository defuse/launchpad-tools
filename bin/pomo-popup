"""
Pomodoro window for the Launchpad pomodoro tab.

A mirror of what the pads are showing, annotated with what you can do about it
*now*: an idle row is told how to start, an elapsed one how to claim or write
off, a running one how to abandon. A hint for something the board cannot
currently do is a hint in the way, so nothing is said about claiming until
there is something to claim.

The second-last row is a todo list rather than free toggles. A slot always
exists and always has a state; naming it lights the pad white, and starting it
turns it red and then green exactly like a habit. Dragging a slot MOVES it,
shifting everything between it and where it lands -- left or right, whichever
way that turns out to be -- because a todo list has an order and swapping two
items is not the edit anyone means.

stdin:   data <json>   {rows: [...], todo: [...]}
         show          display
         hide          withdraw
stdout:  set <col> <name>      a slot renamed
         state <col> <v>       a slot's state changed from this window
         move <from> <to>      a slot dragged somewhere else
         clear                 empty the list
         closed                the window went away
"""
import sys, json, re, subprocess, threading, queue
import tkinter as tk

COLS = 8
TODO_ROW = 6                               # the row the slots mirror
BG, CELL_BG, MUTED = '#0d0d11', '#191920', '#5a5a66'
WHITE, RED, GREEN, BLUE = '#e8e8e8', '#ff4444', '#33d17a', '#5a7bff'
YELLOW_B = '#ffd21a'
# the done tint follows the pad's lighter green, not the pomodoro one
STATE_BG = {0: CELL_BG, 1: '#3a1618', 2: '#1b3a24'}
ROW_H, TODO_H = 96, 150
PAD_W, SLOT_W = 108, 150                   # a pad, and the todo slot under it
MONO = ('DejaVu Sans Mono', 11)            # todo names: fixed pitch, small
DRAG_SLOP = 6                              # px of wobble that is still a click

# What to say about a row, by the state it is actually in. Anything else would
# be an instruction for a button that is not there.
# (left of the row, right of the row). An arrow points at the pad it is about,
# so a hint is attached to a button rather than to a row: the left ones point
# right at the first pad, the right one points left at the last.
HINTS = {
    'idle':    (('click to start \u2192', WHITE), None),
    'running': (('hold 2s to abandon \u2192', GREEN), None),
    'elapsed': (('write it off \u2192', RED), ('\u2190 claim it', GREEN)),
    'claimed': (('hold 2s to clear \u2192', GREEN), None),
}


def g9_centre_box():
    """The widest monitor's work area. Same as the other two windows, so every
    peek lands where the last one did."""
    try:
        mons = subprocess.run(['xrandr', '--listmonitors'],
                              capture_output=True, text=True).stdout
        best = None
        for line in mons.splitlines():
            m = re.search(r'(\d+)/\d+x(\d+)/\d+\+(\d+)\+(\d+)', line)
            if m:
                w, h, x, y = map(int, m.groups())
                if not best or w > best[0]:
                    best = (w, h, x, y)
        gw, gh, gx, gy = best
        wa = subprocess.run(['xprop', '-root', '_NET_WORKAREA'],
                            capture_output=True, text=True).stdout
        n = [int(v) for v in re.findall(r'\d+', wa.split('=')[1])]
        top, bot = max(gy, n[1]), min(gy + gh, n[1] + n[3])
        w = min(3840, gw)
        return w, bot - top, gx + (gw - w) // 2, top
    except Exception:
        return 1600, 900, 100, 100


def say(line):
    sys.stdout.write(line + '\n')
    sys.stdout.flush()


class Window:
    def __init__(self):
        self.rows = []                     # [{row, kind, state, lit, cells}]
        self.todo = [{'name': '', 'state': 0} for _ in range(COLS)]
        self.drag_from = None
        self.dragged = False
        self.grabbed_at = (0, 0)
        self.ghost = None
        self._painting = False
        self._built = False
        self._fits = []
        self.root = tk.Tk()
        self.root.title('pomodoro')
        self.root.configure(bg=BG)
        self.root.attributes('-topmost', True)
        w, h, x, y = g9_centre_box()
        self.root.geometry(f'{w}x{h}+{x}+{y}')
        self.root.protocol('WM_DELETE_WINDOW', self.close)

        # expand without fill: the block takes its own size from its rows and
        # pack centres it, so the grid sits in the middle of the screen rather
        # than hugging the left edge with the hints marooned on the right
        outer = tk.Frame(self.root, bg=BG)
        outer.pack(expand=True)
        self.outer = outer
        self.row_frames, self.row_pads, self.row_hints, self.row_names = {}, {}, {}, {}
        self.row_lefts = {}
        self.slots, self.entries = {}, {}
        self.root.bind_all('<Escape>', lambda ev: (self.close(), 'break')[1])
        self.root.withdraw()

    # ---- geometry --------------------------------------------------------
    def place(self):
        """Put the window on the big monitor, every time it is shown.

        Not once at construction: if xrandr is slow or unavailable at that
        moment the fallback geometry applies and the window spends the rest of
        the session on whichever monitor 100,100 happens to be.
        """
        w, h, x, y = g9_centre_box()
        self.root.geometry(f'{w}x{h}+{x}+{y}')

    def fit(self):
        """Keep the frame inside the work area; see habit-popup for why this is
        measured rather than predicted."""
        try:
            self.root.update_idletasks()
            wa = subprocess.run(['xprop', '-root', '_NET_WORKAREA'],
                                capture_output=True, text=True).stdout
            n = [int(v) for v in re.findall(r'\d+', wa.split('=')[1])]
            ex = subprocess.run(['xprop', '-id', str(self.root.winfo_id()),
                                 '_NET_FRAME_EXTENTS'],
                                capture_output=True, text=True).stdout
            border = int(re.findall(r'\d+', ex.split('=')[1])[3]) if '=' in ex else 8
            h = n[1] + n[3] - self.root.winfo_rooty() - border
            if 240 <= h < self.root.winfo_height():
                self.root.geometry(f'{self.root.winfo_width()}x{h}')
        except Exception:
            pass

    # ---- building --------------------------------------------------------
    def build(self):
        """Rebuild the grid. Cheap enough to redo per data frame, and it keeps
        the widget tree honest when the number of timer rows changes."""
        for child in self.outer.winfo_children():
            child.destroy()
        self.row_frames, self.row_pads, self.row_hints, self.row_names = {}, {}, {}, {}
        self.row_lefts = {}
        self.slots, self.entries = {}, {}

        self._built = True
        line = 0
        for info in self.rows:
            self.outer.grid_rowconfigure(line, minsize=ROW_H)
            # no fixed width: the column is as wide as the longest name, so
            # 'timer 1 (24 min)' is not clipped at its left edge
            name = tk.Label(self.outer, text=info.get('name', ''),
                            font=('DejaVu Sans', 15), fg=MUTED, bg=BG, anchor='e')
            name.grid(row=line, column=0, sticky='e', padx=(0, 14))
            self.row_names[info['row']] = name
            left = tk.Label(self.outer, text='', font=('DejaVu Sans', 16),
                            fg=MUTED, bg=BG, anchor='e', width=22)
            left.grid(row=line, column=1, sticky='e', padx=(0, 10))
            self.row_lefts[info['row']] = left
            # the pads share the todo list's columns, so pad c sits directly
            # above slot c and the window is a mirror rather than two rows that
            # happen to have eight of something
            cells = []
            for c in range(COLS):
                p = tk.Frame(self.outer, bg=CELL_BG, width=PAD_W, height=PAD_W,
                             highlightthickness=3, highlightbackground=BG)
                p.grid(row=line, column=2 + c, padx=4, pady=4)
                p.grid_propagate(False)
                p.bind('<ButtonPress-1>',
                       lambda ev, rr=info['row'], cc=c: say(f'press\t{rr}\t{cc}'))
                p.bind('<ButtonRelease-1>',
                       lambda ev, rr=info['row'], cc=c: say(f'release\t{rr}\t{cc}'))
                cells.append(p)
            self.row_pads[info['row']] = cells
            hint = tk.Label(self.outer, text='', font=('DejaVu Sans', 17),
                            fg=MUTED, bg=BG, anchor='w')
            hint.grid(row=line, column=2 + COLS, sticky='w', padx=24)
            self.row_hints[info['row']] = hint
            line += 1

        # ---- the todo list, one cell per pad of the row it mirrors --------
        self.outer.grid_rowconfigure(line, minsize=24)
        line += 1
        self.outer.grid_rowconfigure(line, minsize=TODO_H)
        tk.Label(self.outer, text='todo', font=('DejaVu Sans', 15),
                 fg=MUTED, bg=BG, anchor='e').grid(row=line, column=0,
                                                   sticky='e', padx=(0, 14))
        for c in range(COLS):
            # no fixed height and propagation left on: the slot is as tall as
            # its text box, and every box is set to the same number of lines,
            # so the row is one block however long the longest item is
            f = tk.Frame(self.outer, bg=CELL_BG,
                         highlightthickness=4, highlightbackground=BG)
            f.grid(row=line, column=2 + c, padx=4, pady=4, sticky='nsew')
            self.slots[c] = f
            handle = tk.Label(f, text='⠿', font=('DejaVu Sans', 13), fg=MUTED,
                              bg=CELL_BG, cursor='fleur')
            handle.pack(anchor='nw', padx=8, pady=(4, 0))
            # a Text, not an Entry: an Entry is one line and scrolls sideways,
            # which hides the end of anything that does not fit
            e = tk.Text(f, font=MONO, bg=CELL_BG, fg=WHITE,
                        insertbackground=WHITE, relief='flat', width=13, height=1,
                        wrap='word', spacing1=1, spacing3=1, padx=6, pady=2,
                        highlightthickness=0, cursor='xterm')
            e.pack(fill='x', padx=4, pady=(0, 6))
            self.entries[c] = e
            e.bind('<KeyRelease>', lambda ev, col=c: self.name_typed(col))
            # a name is one line of text; the box is multiline so it can wrap,
            # not so it can hold paragraphs, and the protocol is line based
            e.bind('<Return>', lambda ev: 'break')
            # The frame and the handle are the pad; the entry is the text box
            # and takes no gesture at all. Dragging inside it is selecting
            # text, and a drag that started there used to move the item
            # instead, which loses both the selection and the order.
            for w in (f, handle):
                w.bind('<Button-1>', lambda ev, col=c: self.grab(col, ev), add='+')
                w.bind('<B1-Motion>', lambda ev, col=c: self.drag(ev, col), add='+')
                w.bind('<ButtonRelease-1>', lambda ev, col=c: self.drop(ev), add='+')
        tk.Button(self.outer, text='clear list', font=('DejaVu Sans', 15),
                  bg=CELL_BG, fg=MUTED, relief='flat', activebackground=CELL_BG,
                  activeforeground=WHITE, command=self.clear
                  ).grid(row=line, column=2 + COLS, sticky='w', padx=24)

    # ---- painting --------------------------------------------------------
    def paint(self):
        self._painting = True
        try:
            for info in self.rows:
                for c, colour in enumerate(info.get('cells', [])[:COLS]):
                    pad = self.row_pads[info['row']][c]
                    pad.configure(bg=colour or CELL_BG)
                left, right = HINTS.get(info.get('state', ''), (None, None))
                self.row_lefts[info['row']].configure(text=left[0] if left else '',
                                                      fg=left[1] if left else MUTED)
                self.row_hints[info['row']].configure(text=right[0] if right else '',
                                                      fg=right[1] if right else MUTED)
            for c in range(COLS):
                slot = self.todo[c]
                bg = STATE_BG.get(slot.get('state', 0), CELL_BG)
                self.slots[c].configure(bg=bg)
                for w in self.slots[c].winfo_children():
                    w.configure(bg=bg)
                box = self.entries[c]
                # never rewrite the box with the cursor in it: the board echoes
                # a normalised name back, and replacing the text underneath a
                # typist moves the insert point to the start and scrolls the
                # view -- which reads as the box refusing to grow
                typing = self.root.focus_get() is box
                if not typing and box.get('1.0', 'end').strip() != slot.get('name', ''):
                    box.delete('1.0', 'end')
                    box.insert('1.0', slot.get('name', ''))
                box.configure(fg=WHITE if slot.get('name') else MUTED, bg=bg)
            self.fit_slots()
        finally:
            self._painting = False

    # ---- todo editing ----------------------------------------------------
    def name_typed(self, col):
        if self._painting:
            return
        name = re.sub(r'\s+', ' ', self.entries[col].get('1.0', 'end')).strip()
        self.todo[col]['name'] = name
        self.fit_slots()
        say(f'set\t{col}\t{name}')

    def fit_slots(self):
        """Every box as tall as the tallest one needs to be.

        Tk counts the lines a Text actually displays after wrapping, which is
        the only honest answer -- the alternative is dividing characters by a
        guessed width and being wrong for every proportional font. Growing them
        all together keeps the row a row rather than a skyline.
        """
        if self.root.state() == 'withdrawn':
            return                             # Tk cannot count what it is not drawing
        self.root.update_idletasks()
        need = 1
        for t in self.entries.values():
            try:
                n = t.count('1.0', 'end - 1c', 'displaylines')
                n = n[0] if isinstance(n, tuple) else int(n or 1)
            except Exception:
                n = 1
            need = max(need, n or 1)
        for t in self.entries.values():
            if int(t.cget('height')) != need:
                t.configure(height=need)

    def clear(self):
        self.todo = [{'name': '', 'state': 0} for _ in range(COLS)]
        say('clear')
        self.paint()

    # ---- drag to move, tap to press --------------------------------------
    def grab(self, col, ev):
        """Start of a gesture on a slot. Which gesture it turns out to be is
        decided on release: no real movement makes it a tap on the pad,
        movement makes it a drag. Gestures inside the text box never get here."""
        self.drag_from = col
        self.dragged = False
        self.grabbed_at = (ev.x_root, ev.y_root)

    def drag(self, ev, col):
        if self.drag_from is None:
            return
        # a hand moves a few pixels while clicking; treating that as a drag
        # meant taps on the handle went nowhere, which is worse than a drag
        # that needs a moment to start
        ox, oy = self.grabbed_at
        if not self.dragged and max(abs(ev.x_root - ox), abs(ev.y_root - oy)) < DRAG_SLOP:
            return
        self.dragged = True
        if self.ghost is None:
            name = self.todo[self.drag_from].get('name') or '(empty)'
            g = tk.Toplevel(self.root)
            g.overrideredirect(True)
            g.attributes('-topmost', True)
            g.attributes('-alpha', 0.85)
            tk.Label(g, text=name, font=('DejaVu Sans', 18, 'bold'), fg=WHITE,
                     bg='#000008', padx=16, pady=8, highlightthickness=3,
                     highlightbackground=YELLOW_B).pack()
            self.ghost = g
        self.ghost.geometry(f'+{ev.x_root + 18}+{ev.y_root + 16}')

    def drop(self, ev):
        src, self.drag_from = self.drag_from, None
        dragged, self.dragged = self.dragged, False
        self.kill_ghost()
        if src is None:
            return
        if not dragged:
            # a tap: the same thing pressing the pad does
            say(f'press\t{TODO_ROW}\t{src}')
            say(f'release\t{TODO_ROW}\t{src}')
            return
        dst = self.slot_under(ev.x_root, ev.y_root)
        if dst is None or dst == src:
            return
        # a move, so everything between shifts one way or the other
        self.todo.insert(dst, self.todo.pop(src))
        say(f'move\t{src}\t{dst}')
        self.paint()

    def slot_under(self, x, y):
        for c, f in self.slots.items():
            fx, fy = f.winfo_rootx(), f.winfo_rooty()
            if fx <= x < fx + f.winfo_width() and fy <= y < fy + f.winfo_height():
                return c
        return None

    def kill_ghost(self):
        if self.ghost is not None:
            try:
                self.ghost.destroy()
            except Exception:
                pass
            self.ghost = None

    # ---- protocol --------------------------------------------------------
    def handle(self, line):
        p = line.split('\t')
        if p[0] == 'data' and len(p) > 1:
            blob = json.loads(p[1])
            rows = blob.get('rows', [])
            # rebuild only when the set of rows changes: it destroys every
            # widget, and doing that on each frame would take the text box out
            # from under whoever is typing in it
            rebuild = ([r['row'] for r in rows] != [r['row'] for r in self.rows]
                       or not self._built)
            self.rows = rows
            self.todo = blob.get('todo', self.todo)
            if rebuild:
                self.build()
            self.paint()
        elif p[0] == 'show':
            if not self._built:
                self.build()
            self.paint()
            self.place()
            self.root.deiconify()
            self.root.lift()
            self.root.attributes('-topmost', True)
            self.root.update_idletasks()
            # only now can Tk say how many lines a box actually displays: a
            # withdrawn window answers None, which would leave every box one
            # line tall with the rest of the text out of sight
            self.fit_slots()
            self.fit()
            for ms in (120, 600):
                self._fits.append(self.root.after(ms, self.fit))
                self._fits.append(self.root.after(ms, self.fit_slots))
        elif p[0] == 'hide':
            self.hide()

    def hide(self):
        while self._fits:
            try:
                self.root.after_cancel(self._fits.pop())
            except Exception:
                pass
        self.kill_ghost()
        self.root.withdraw()

    def close(self):
        self.hide()
        say('closed')

    def run(self):
        q = queue.Queue()

        def rd():
            for l in sys.stdin:
                q.put(l.rstrip('\n'))
            q.put(None)
        threading.Thread(target=rd, daemon=True).start()

        def pump():
            try:
                while True:
                    l = q.get_nowait()
                    if l is None:
                        self.root.destroy()
                        return
                    try:
                        self.handle(l)
                    except Exception as e:
                        print(f'bad command {l[:60]!r}: {e!r}', file=sys.stderr, flush=True)
            except queue.Empty:
                pass
            self.root.after(16, pump)
        self.root.after(16, pump)
        self.root.mainloop()


if __name__ == '__main__':
    Window().run()
